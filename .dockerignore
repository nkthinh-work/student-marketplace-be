# Virtual environments
.venv/
venv/
ENV/

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Git & IDE
.git/
.gitignore
.vscode/

# Environment variables & secrets
.env

# Secrets must never be baked into Docker images
secrets/
firebase-service-account.json
service-account*.json
*-firebase-adminsdk-*.json
*.pem
*.key

# Scratch & coverage artifacts
scratch/
.coverage
.coverage.*
htmlcov/

# Database dumps must never be baked into Docker images
backups/
production_backups/
*.dump
*.dump.part

# Tests & Documentation (không cần thiết trong runtime production image)
tests/
docs/
.roo/
*.md