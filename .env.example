# General Settings
PROJECT_NAME=Student Marketplace C2C Backend
LOG_LEVEL=INFO

# PostgreSQL Connection
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=student_marketplace
POSTGRES_PORT=5432
DATABASE_URL=

# Redis Connection
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Cloudinary Integration (Optional in Phase 0)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_ROOT_FOLDER=student-marketplace

# Firebase Authentication
# Local development: path to Firebase Admin service-account JSON.
# Never commit the real credential file.
FIREBASE_CREDENTIALS_PATH=

# Worker Settings
WORKER_POLL_INTERVAL_SECONDS=30
WORKER_BATCH_SIZE=50
WORKER_MAX_RETRIES=3
WORKER_RETRY_BACKOFF_SECONDS=0.5

# Product View Counter (Phase 9B)
PRODUCT_VIEW_DEDUPE_SECONDS=86400
PRODUCT_VIEW_FLUSH_INTERVAL_SECONDS=60
PRODUCT_VIEW_FLUSH_BATCH_SIZE=200

# Community Creator (Feedback / VietQR Support)
# Set this to the internal users.user_id of the creator/Admin account that should appear on the Feedback support card
COMMUNITY_CREATOR_USER_ID=
