# General Settings
PROJECT_NAME=Student Marketplace C2C Backend
LOG_LEVEL=INFO

# PostgreSQL Connection
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=student_marketplace
POSTGRES_PORT=5432
DATABASE_URL=

# Redis Connection
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Cloudinary Integration (Optional in Phase 0)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_ROOT_FOLDER=student-marketplace

# Firebase Authentication
# Local development: path to Firebase Admin service-account JSON.
# Never commit the real credential file.
FIREBASE_CREDENTIALS_PATH=
