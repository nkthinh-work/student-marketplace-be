# General Settings
PROJECT_NAME=Student Marketplace C2C Backend
LOG_LEVEL=INFO
ENVIRONMENT=development
BACKEND_CORS_ORIGINS=http://localhost:3000

# PostgreSQL Connection
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=student_marketplace
POSTGRES_PORT=5432
DATABASE_URL=

# Redis Connection
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Cloudinary Integration (Optional in Phase 0)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_ROOT_FOLDER=student-marketplace

# Firebase Authentication
# FIREBASE_CREDENTIALS_PATH is suitable for local/file-based deployment.
# FIREBASE_CREDENTIALS_JSON is suitable for secret environment injection such as Railway.
# Never commit real credentials to Git or Docker images.
FIREBASE_CREDENTIALS_PATH=
FIREBASE_CREDENTIALS_JSON=

# Worker Settings
WORKER_POLL_INTERVAL_SECONDS=30
WORKER_BATCH_SIZE=50
WORKER_MAX_RETRIES=3
WORKER_RETRY_BACKOFF_SECONDS=0.5

# Product View Counter (Phase 9B)
PRODUCT_VIEW_DEDUPE_SECONDS=86400
PRODUCT_VIEW_FLUSH_INTERVAL_SECONDS=60
PRODUCT_VIEW_FLUSH_BATCH_SIZE=200

# Community Creator (Feedback / VietQR Support)
# Stable server-side identity of the creator account appearing on the Feedback support card.
# Recommended: Firebase Provider UID (mapped in user_auth_identities).
COMMUNITY_CREATOR_PROVIDER_UID=
# Optional fallback if provider UID is not yet provisioned: unique email of the creator account.
COMMUNITY_CREATOR_EMAIL=

# Official Support Group (stable conversation_id for official support GROUP)
OFFICIAL_SUPPORT_GROUP_ID=
